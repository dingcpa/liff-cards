{
  "type": "bubble",
  "size": "mega",
  "header": {
    "type": "box",
    "layout": "vertical",
    "backgroundColor": "#12355B",
    "paddingAll": "24px",
    "contents": [
      {
        "type": "box",
        "layout": "vertical",
        "borderColor": "#E6C96A",
        "borderWidth": "1px",
        "cornerRadius": "999px",
        "paddingTop": "4px",
        "paddingBottom": "4px",
        "paddingStart": "14px",
        "paddingEnd": "14px",
        "width": "104px",
        "contents": [
          {
            "type": "text",
            "text": "開 會 通 知",
            "color": "#E6C96A",
            "size": "sm",
            "weight": "bold",
            "align": "center"
