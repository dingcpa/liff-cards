            "size": "lg",
            "weight": "bold",
            "color": "#1C2733",
            "flex": 1,
            "margin": "xl"
          }
        ]
      },
      {
        "type": "box",
        "layout": "horizontal",
        "contents": [
          {
            "type": "text",
            "text": "地點",
            "size": "md",
            "color": "#7B8794",
            "flex": 0
