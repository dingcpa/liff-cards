            "flex": 1,
            "contents": [
              {
                "type": "text",
                "text": "中央聯合辦公大樓南棟",
                "size": "lg",
                "weight": "bold",
                "color": "#1C2733",
                "wrap": true
              },
              {
                "type": "text",
                "text": "18樓 第20會議室",
                "size": "lg",
                "weight": "bold",
                "color": "#1C2733",
                "wrap": true
