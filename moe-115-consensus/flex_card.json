              {
                "type": "text",
                "text": "臺北市中正區徐州路5號 🗺",
                "size": "md",
                "color": "#1D4E89",
                "decoration": "underline",
                "margin": "sm",
                "wrap": true,
                "action": {
                  "type": "uri",
                  "label": "開啟地圖",
                  "uri": "https://www.google.com/maps/search/?api=1&query=%E8%87%BA%E5%8C%97%E5%B8%82%E4%B8%AD%E6%AD%A3%E5%8D%80%E5%BE%90%E5%B7%9E%E8%B7%AF5%E8%99%9F"
